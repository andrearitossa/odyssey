{
  "name": "odissey",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start",
    "start:prod": "EXPO_PUBLIC_APP_ENV=production expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:production": "npm run build:web",
    "deploy": "npm run build:production && wrangler deploy",
    "deploy:dev": "EXPO_PUBLIC_APP_ENV=development npm run build:web && wrangler deploy",
    "dev:worker": "npm run build:web && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.10",
    "@react-navigation/native-stack": "^7.3.14",
    "expo": "53.0.18",
    "expo-asset": "~11.1.7",
    "expo-crypto": "^14.1.5",
    "expo-font": "~13.3.2",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.0.10",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "wrangler": "^4.23.0"
  },
  "private": true
}
